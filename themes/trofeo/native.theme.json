{
  "name": "Trofeo Native",
  "layout": "trofeo_vertical_v1",
  "width": 462,
  "height": 1920,
  "background": "#000000",
  "background_sequence": {
    "path": "assets/background",
    "pattern": "frame_%04d.jpg",
    "fps": 24,
    "opacity": 1.0,
