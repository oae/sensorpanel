    "jpeg_quality": 68,
    "prefetch_frames": 1,
    "jpeg_encoder": "auto"
  },
  "accent": "#2de2ff",
  "accent2": "#ff4df3",
  "text": "#f8fbff",
  "muted": "#8ea1bb",
  "panel": "#06132688",
  "panel_line": "#245cff99"
}
